# Copy this file to `.env` and fill in API keys for the providers you want to run.
# All experiments call OpenAI-compatible chat-completions endpoints (temperature=0.0).
# Leave unused providers blank.

# DeepSeek (primary back-end, paper alias: deepseek-v4-flash) - https://api.deepseek.com
DEEPSEEK_API_KEY=

# Alibaba Qwen (qwen-max) - https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# Moonshot Kimi (moonshot-v1-8k) - https://api.moonshot.cn/v1
KIMI_API_KEY=

# Zhipu GLM (glm-4-flash) - https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
